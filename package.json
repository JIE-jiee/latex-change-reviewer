{
  "name": "latex-change-reviewer",
  "displayName": "%displayName%",
  "description": "%description%",
  "publisher": "local-latex-tools",
  "version": "0.3.2",
  "engines": {
    "vscode": "^1.85.2"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/src/extension.js",
  "activationEvents": [
    "onLanguage:latex",
    "onStartupFinished"
  ],
  "scripts": {
    "compile": "tsc -p .",
    "test": "npm run compile && node --test dist/tests/parser.test.js dist/tests/navigation.test.js dist/tests/changeTransforms.test.js dist/tests/comments.test.js",
    "package": "npm run compile && node scripts/package.cjs",
    "test:integration": "npm run compile && node dist/tests/runIntegration.js",
    "package:marketplace": "npm run compile && node scripts/package.cjs --marketplace"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "1.85.0",
    "@vscode/test-electron": "^2.3.9",
    "@vscode/vsce": "^2.24.0",
    "typescript": "^5.3.3"
  },
  "contributes": {
    "commands": [
      {
        "command": "latexReview.acceptCurrent",
        "title": "%command.acceptCurrent%",
        "enablement": "latexReview.enabled && latexReview.hasCurrent && latexReview.writable && !latexReview.busy && !editorReadonly"
      },
      {
        "command": "latexReview.rejectCurrent",
        "title": "%command.rejectCurrent%",
        "enablement": "latexReview.enabled && latexReview.hasCurrent && latexReview.writable && !latexReview.busy && !editorReadonly"
      },
      {
        "command": "latexReview.nextChange",
        "title": "%command.nextChange%",
        "enablement": "latexReview.enabled && latexReview.supported && !latexReview.busy"
      },
      {
        "command": "latexReview.previousChange",
        "title": "%command.previousChange%",
        "enablement": "latexReview.enabled && latexReview.supported && !latexReview.busy"
      },
      {
        "command": "latexReview.refresh",
        "title": "%command.refresh%",
        "enablement": "latexReview.enabled && latexReview.supported && !latexReview.busy"
      },
      {
        "command": "latexReview.toggleReview",
        "title": "%command.toggleReview%",
        "icon": "$(checklist)",
        "enablement": "latexReview.supported"
      },
      {
        "command": "latexReview.locateCurrent",
        "title": "%command.locateCurrent%",
        "enablement": "latexReview.enabled && latexReview.supported && !latexReview.busy"
      },
      {
        "command": "latexReview.selectLanguage",
        "title": "%command.selectLanguage%"
      },
      {
        "command": "latexReview.addComment",
        "title": "%command.addComment%",
        "enablement": "latexReview.supported && !editorReadonly && latexReview.enabled && latexReview.writable"
      },
      {
        "command": "latexReview.editComment",
        "title": "%command.editComment%",
        "enablement": "latexReview.supported && latexReview.enabled && latexReview.writable && !editorReadonly"
      },
      {
        "command": "latexReview.removeComment",
        "title": "%command.removeComment%",
        "enablement": "latexReview.supported && latexReview.enabled && latexReview.writable && !editorReadonly"
      },
      {
        "command": "latexReview.nextComment",
        "title": "%command.nextComment%",
        "enablement": "latexReview.supported && latexReview.enabled"
      },
      {
        "command": "latexReview.toggleTracking",
        "title": "%command.toggleTracking%",
        "icon": "$(edit)",
        "enablement": "latexReview.supported && !editorReadonly"
      },
      {
        "command": "latexReview.markAddition",
        "title": "%command.markAddition%",
        "enablement": "latexReview.supported && latexReview.tracking && !latexReview.trackingPaused && !editorReadonly"
      },
      {
        "command": "latexReview.markDeletion",
        "title": "%command.markDeletion%",
        "enablement": "latexReview.supported && latexReview.tracking && !latexReview.trackingPaused && !editorReadonly"
      },
      {
        "command": "latexReview.replaceWithRevision",
        "title": "%command.replaceWithRevision%",
        "enablement": "latexReview.supported && latexReview.tracking && !latexReview.trackingPaused && !editorReadonly"
      },
      {
        "command": "latexReview.mergeSelectedChanges",
        "title": "%command.mergeSelectedChanges%",
        "enablement": "latexReview.supported && latexReview.tracking && !latexReview.trackingPaused && !editorReadonly"
      },
      {
        "command": "latexReview.showTrackingDiff",
        "title": "%command.showTrackingDiff%",
        "enablement": "latexReview.supported && latexReview.trackingPaused"
      },
      {
        "command": "latexReview.saveComment",
        "title": "%command.saveComment%"
      },
      {
        "command": "latexReview.cancelComment",
        "title": "%command.cancelComment%"
      },
      {
        "command": "latexReview.trackingDeleteLeft",
        "title": "%command.trackingDeleteLeft%"
      },
      {
        "command": "latexReview.trackingDeleteRight",
        "title": "%command.trackingDeleteRight%"
      },
      {
        "command": "latexReview.trackingPaste",
        "title": "%command.trackingPaste%"
      },
      {
        "command": "latexReview.trackingCut",
        "title": "%command.trackingCut%"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "latexReview.acceptCurrent",
          "when": "latexReview.supported && latexReview.enabled && latexReview.hasCurrent && latexReview.writable && !latexReview.busy"
        },
        {
          "command": "latexReview.rejectCurrent",
          "when": "latexReview.supported && latexReview.enabled && latexReview.hasCurrent && latexReview.writable && !latexReview.busy"
        },
        {
          "command": "latexReview.nextChange",
          "when": "latexReview.supported && latexReview.enabled && !latexReview.busy"
        },
        {
          "command": "latexReview.previousChange",
          "when": "latexReview.supported && latexReview.enabled && !latexReview.busy"
        },
        {
          "command": "latexReview.refresh",
          "when": "latexReview.supported && latexReview.enabled && !latexReview.busy"
        },
        {
          "command": "latexReview.toggleReview",
          "when": "latexReview.supported"
        },
        {
          "command": "latexReview.selectLanguage"
        },
        {
          "command": "latexReview.locateCurrent",
          "when": "latexReview.supported && latexReview.enabled && !latexReview.busy"
        },
        {
          "command": "latexReview.addComment",
          "when": "latexReview.supported && latexReview.enabled && latexReview.writable"
        },
        {
          "command": "latexReview.editComment",
          "when": "latexReview.supported && latexReview.enabled"
        },
        {
          "command": "latexReview.removeComment",
          "when": "latexReview.supported && latexReview.enabled"
        },
        {
          "command": "latexReview.nextComment",
          "when": "latexReview.supported && latexReview.enabled"
        },
        {
          "command": "latexReview.toggleTracking",
          "when": "latexReview.supported && !editorReadonly"
        },
        {
          "command": "latexReview.markAddition",
          "when": "latexReview.tracking && !latexReview.trackingPaused && editorTextFocus"
        },
        {
          "command": "latexReview.markDeletion",
          "when": "latexReview.tracking && !latexReview.trackingPaused && editorTextFocus"
        },
        {
          "command": "latexReview.replaceWithRevision",
          "when": "latexReview.tracking && !latexReview.trackingPaused && editorTextFocus"
        },
        {
          "command": "latexReview.mergeSelectedChanges",
          "when": "latexReview.tracking && !latexReview.trackingPaused && editorTextFocus"
        },
        {
          "command": "latexReview.showTrackingDiff",
          "when": "latexReview.trackingPaused"
        },
        {
          "command": "latexReview.saveComment",
          "when": "false"
        },
        {
          "command": "latexReview.cancelComment",
          "when": "false"
        },
        {
          "command": "latexReview.trackingDeleteLeft",
          "when": "false"
        },
        {
          "command": "latexReview.trackingDeleteRight",
          "when": "false"
        },
        {
          "command": "latexReview.trackingPaste",
          "when": "false"
        },
        {
          "command": "latexReview.trackingCut",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "latexReview.acceptCurrent",
          "when": "latexReview.supported && latexReview.enabled && latexReview.hasCurrent && latexReview.writable && !latexReview.busy && editorTextFocus",
          "group": "navigation@10"
        },
        {
          "command": "latexReview.rejectCurrent",
          "when": "latexReview.supported && latexReview.enabled && latexReview.hasCurrent && latexReview.writable && !latexReview.busy && editorTextFocus",
          "group": "navigation@11"
        },
        {
          "command": "latexReview.previousChange",
          "when": "latexReview.supported && latexReview.enabled && !latexReview.busy && editorTextFocus",
          "group": "navigation@12"
        },
        {
          "command": "latexReview.nextChange",
          "when": "latexReview.supported && latexReview.enabled && !latexReview.busy && editorTextFocus",
          "group": "navigation@13"
        },
        {
          "command": "latexReview.addComment",
          "when": "latexReview.supported && editorTextFocus && latexReview.enabled && latexReview.writable",
          "group": "navigation@20"
        },
        {
          "command": "latexReview.editComment",
          "when": "latexReview.supported && latexReview.enabled && latexReview.hasComment && editorTextFocus",
          "group": "navigation@21"
        },
        {
          "command": "latexReview.removeComment",
          "when": "latexReview.supported && latexReview.enabled && latexReview.hasComment && editorTextFocus",
          "group": "navigation@22"
        },
        {
          "command": "latexReview.nextComment",
          "when": "latexReview.supported && latexReview.enabled && latexReview.hasComments && editorTextFocus",
          "group": "navigation@23"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "latexReview.editComment",
          "when": "commentThread == latexReviewComment && latexReview.enabled"
        },
        {
          "command": "latexReview.removeComment",
          "when": "commentThread == latexReviewComment && latexReview.enabled"
        }
      ],
      "editor/title": [
        {
          "command": "latexReview.toggleReview",
          "when": "latexReview.supported",
          "group": "navigation@80"
        },
        {
          "command": "latexReview.toggleTracking",
          "when": "latexReview.supported && !editorReadonly",
          "group": "navigation@81"
        }
      ],
      "comments/comment/context": [
        {
          "command": "latexReview.saveComment",
          "when": "commentThread == latexReviewDraftComment && comment == latexReviewComment",
          "group": "navigation@1"
        },
        {
          "command": "latexReview.cancelComment",
          "when": "commentThread == latexReviewDraftComment && comment == latexReviewComment",
          "group": "navigation@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "latexReview.trackingDeleteLeft",
        "key": "backspace",
        "when": "latexReview.tracking && editorTextFocus && !isComposing && !editorReadonly && !latexReview.trackingPaused && !editorSimpleInput"
      },
      {
        "command": "latexReview.trackingDeleteRight",
        "key": "delete",
        "when": "latexReview.tracking && editorTextFocus && !isComposing && !editorReadonly && !latexReview.trackingPaused && !editorSimpleInput"
      },
      {
        "command": "latexReview.trackingPaste",
        "key": "ctrl+v",
        "when": "latexReview.tracking && editorTextFocus && !isComposing && !editorReadonly && !latexReview.trackingPaused && !editorSimpleInput"
      },
      {
        "command": "latexReview.trackingPaste",
        "key": "cmd+v",
        "when": "latexReview.tracking && editorTextFocus && !isComposing && !editorReadonly && !latexReview.trackingPaused && !editorSimpleInput"
      },
      {
        "command": "latexReview.trackingCut",
        "key": "ctrl+x",
        "when": "latexReview.tracking && editorTextFocus && !isComposing && !editorReadonly && !latexReview.trackingPaused && !editorSimpleInput"
      },
      {
        "command": "latexReview.trackingCut",
        "key": "cmd+x",
        "when": "latexReview.tracking && editorTextFocus && !isComposing && !editorReadonly && !latexReview.trackingPaused && !editorSimpleInput"
      },
      {
        "command": "latexReview.acceptCurrent",
        "key": "ctrl+k alt+a",
        "when": "config.latexReview.enableDefaultKeybindings && latexReview.supported && latexReview.enabled && latexReview.hasCurrent && latexReview.writable && !latexReview.busy && editorTextFocus && !isComposing && !editorReadonly"
      },
      {
        "command": "latexReview.rejectCurrent",
        "key": "ctrl+k alt+r",
        "when": "config.latexReview.enableDefaultKeybindings && latexReview.supported && latexReview.enabled && latexReview.hasCurrent && latexReview.writable && !latexReview.busy && editorTextFocus && !isComposing && !editorReadonly"
      },
      {
        "command": "latexReview.nextChange",
        "key": "ctrl+k alt+n",
        "when": "config.latexReview.enableDefaultKeybindings && latexReview.supported && latexReview.enabled && !latexReview.busy && editorTextFocus && !isComposing"
      },
      {
        "command": "latexReview.previousChange",
        "key": "ctrl+k alt+p",
        "when": "config.latexReview.enableDefaultKeybindings && latexReview.supported && latexReview.enabled && !latexReview.busy && editorTextFocus && !isComposing"
      },
      {
        "command": "latexReview.toggleReview",
        "key": "ctrl+k alt+t",
        "when": "config.latexReview.enableDefaultKeybindings && latexReview.supported && editorTextFocus && !isComposing"
      }
    ],
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "latexReview.uiLanguage": {
          "type": "string",
          "enum": [
            "auto",
            "zh-CN",
            "en",
            "ja"
          ],
          "default": "auto",
          "description": "%configuration.uiLanguage%"
        },
        "latexReview.autoGoToNext": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.autoGoToNext%"
        },
        "latexReview.highlightChanges": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.highlightChanges%"
        },
        "latexReview.showReviewToolbar": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.showReviewToolbar%"
        },
        "latexReview.enableDefaultKeybindings": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.enableDefaultKeybindings%"
        },
        "latexReview.authorId": {
          "type": "string",
          "default": "",
          "description": "%configuration.authorId%"
        }
      }
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JIE-jiee/latex-change-reviewer.git"
  },
  "homepage": "https://github.com/JIE-jiee/latex-change-reviewer#readme",
  "bugs": {
    "url": "https://github.com/JIE-jiee/latex-change-reviewer/issues"
  },
  "icon": "media/icon.png",
  "keywords": [
    "latex",
    "changes",
    "review",
    "track changes",
    "comments",
    "accept",
    "reject"
  ],
  "galleryBanner": {
    "color": "#12233a",
    "theme": "dark"
  },
  "pricing": "Free"
}
